      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.sendRequest({",
              "    url: pm.collectionVariables.get('baseUrl') + '/api/auth/login',",
              "    method: 'POST',",
              "    header: { 'Content-Type': 'application/json' },",
              "    body: {",
              "        mode: 'raw',",
              "        raw: JSON.stringify({",
              "            email: pm.collectionVariables.get('librarianEmail'),",
              "            password: pm.collectionVariables.get('librarianPassword')",
              "        })",
              "    }",
              "}, (err, res) => {",
              "    if (!err && res.code === 200) {",
              "        pm.collectionVariables.set('librarianToken', res.json().token);",
              "    }",
              "});"
            ]
          }
        }
