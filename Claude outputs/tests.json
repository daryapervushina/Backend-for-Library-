    {
      "name": "02_Books_Public",
      "item": [
        {
          "name": "GET /api/books (public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Items array', () => pm.expect(b.items).to.be.an('array'));",
                  "pm.test('At least 6 books', () => pm.expect(b.items.length).to.be.at.least(6));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/books"
          }
        },
        {
          "name": "GET /api/books?available=true",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('All items have available_copies > 0', () => {",
                  "  b.items.forEach(i => pm.expect(i.available_copies).to.be.greaterThan(0));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/books?available=true"
          }
        },
        {
          "name": "GET /api/books?search=Book 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Search narrows result', () => pm.expect(b.items.length).to.be.at.most(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/books?search=Book%201"
          }
        }
      ]
    },
